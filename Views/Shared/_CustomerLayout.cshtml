<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - MyStore</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <!-- Header -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">My Store</a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Home")">Trang chủ</a></li>
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Product")">Sản phẩm</a></li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Cart")">
                            🛒 Giỏ hàng
                            <span class="badge bg-danger">@(Session["Cart"] != null ? ((List<_25dh110089_MyStore.Models.CartItem>)Session["Cart"]).Sum(x => x.Quantity) : 0)</span>
                        </a>
                    </li>
                    @if (Session["CustomerUser"] != null)
                    {
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index", "Order")">Lịch sử mua hàng</a></li>
                        <li class="nav-item"><span class="nav-link text-light">Chào, @Session["CustomerUser"]</span></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Logout", "Account")">Đăng xuất</a></li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Login", "Account")">Đăng nhập</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Register", "Account")">Đăng ký</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Body -->
    <div class="container mt-4">
        @RenderBody()
    </div>

    <!-- Footer -->
    <footer class="bg-dark text-white text-center py-3 mt-5">
        <p class="mb-0">&copy; 2024 - 25dh110089_MyStore. Thiết kế bởi Nhóm của bạn.</p>
    </footer>
</body>
</html>