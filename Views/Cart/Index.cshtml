@model List<_25dh110089_MyStore.Models.CartItem>
@{ ViewBag.Title = "Giỏ hàng"; }

<h2>Giỏ hàng của bạn</h2>
@if (Model.Count == 0)
{
    <div class="alert alert-info">Giỏ hàng đang trống. <a href="@Url.Action("Index", "Product")">Tiếp tục mua sắm</a></div>
}
else
{
    <table class="table table-bordered">
        <thead class="bg-light">
            <tr>
                <th>Ảnh</th>
                <th>Tên sản phẩm</th>
                <th>Giá</th>
                <th style="width: 150px;">Số lượng</th>
                <th>Thành tiền</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><img src="~/Content/Images/@item.ProductImage" width="60" onerror="this.src='https://via.placeholder.com/60'" /></td>
                    <td>@item.ProductName</td>
                    <td>@String.Format("{0:N0} đ", item.ProductPrice)</td>
                    <td>
                        @using (Html.BeginForm("Update", "Cart", FormMethod.Post, new { @class = "d-flex" }))
                        {
                            <input type="hidden" name="id" value="@item.ProductID" />
                            <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control form-control-sm me-1" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Cập nhật</button>
                        }
                    </td>
                    <td class="text-danger font-weight-bold">@String.Format("{0:N0} đ", item.Quantity * item.ProductPrice)</td>
                    <td>
                        <a href="@Url.Action("Remove", "Cart", new { id = item.ProductID })" class="btn btn-sm btn-danger" onclick="return confirm('Xóa sản phẩm này?')">Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="4" class="text-end font-weight-bold">Tổng cộng:</td>
                <td colspan="2" class="text-danger font-weight-bold fs-5">@String.Format("{0:N0} đ", Model.Sum(x => x.Quantity * x.ProductPrice))</td>
            </tr>
        </tfoot>
    </table>

    <div class="d-flex justify-content-between">
        <a href="@Url.Action("Clear", "Cart")" class="btn btn-outline-danger" onclick="return confirm('Xóa toàn bộ giỏ hàng?')">Xóa tất cả</a>
        <a href="@Url.Action("Checkout", "Cart")" class="btn btn-success btn-lg">Tiến hành đặt hàng</a>
    </div>
}