@model _25dh110089_MyStore.Models.Product
@{ ViewBag.Title = Model.ProductName; }

<div class="row">
    <div class="col-md-5">
        <img src="~/Content/Images/@Model.ProductImage" class="img-fluid border p-2" style="width: 100%; height: 400px; object-fit: contain;" onerror="this.src='https://via.placeholder.com/400?text=No+Image'" />
    </div>
    <div class="col-md-7">
        <h2>@Model.ProductName</h2>
        <p class="text-muted">Danh mục: @(Model.Category != null ? Model.Category.CategoryName : "")</p>
        <h3 class="text-danger mb-4">@String.Format("{0:N0} đ", Model.ProductPrice)</h3>

        <h5>Mô tả sản phẩm:</h5>
        <p>@Model.ProductDescription</p>

        <hr />
        <div class="mt-4">
            <!-- Phần thêm vào giỏ hàng (sẽ code tiếp ở nhịp sau) -->
            <a href="@Url.Action("Index", "Product")" class="btn btn-secondary">Quay lại</a>
            <a href="@Url.Action("Add", "Cart", new { id = Model.ProductID })" class="btn btn-success btn-lg">Thêm vào giỏ hàng</a>
        </div>
    </div>
</div>