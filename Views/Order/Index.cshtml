@model IEnumerable<_25dh110089_MyStore.Models.Order>
@{ ViewBag.Title = "Lịch sử mua hàng"; }

<h2>Lịch sử mua hàng của bạn</h2>
<hr />
@if (!Model.Any())
{
    <div class="alert alert-info">Bạn chưa có đơn hàng nào. <a href="@Url.Action("Index", "Product")">Mua sắm ngay</a></div>
}
else
{
    <table class="table table-bordered">
        <tr class="bg-light">
            <th>Mã đơn</th>
            <th>Ngày đặt</th>
            <th>Tổng tiền</th>
            <th>Trạng thái</th>
            <th>Địa chỉ nhận</th>
            <th></th>
        </tr>
        @foreach (var item in Model)
        {
            <tr>
                <td>#@item.OrderID</td>
                <td>@String.Format("{0:dd/MM/yyyy HH:mm}", item.OrderDate)</td>
                <td class="text-danger font-weight-bold">@String.Format("{0:N0} đ", item.TotalAmount)</td>
                <td><span class="badge bg-success">@item.PaymentStatus</span></td>
                <td>@item.AddressDelivery</td>
                <td>
                    @Html.ActionLink("Xem chi tiết", "Details", new { id = item.OrderID }, new { @class = "btn btn-sm btn-info text-white" })
                </td>
            </tr>
        }
    </table>
}