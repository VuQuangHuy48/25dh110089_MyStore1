<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - TRANG QUẢN TRỊ</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background: #f4f4f4;
        }

        .admin-header {
            background: #333;
            color: #fff;
            padding: 12px 20px;
            margin-bottom: 20px;
        }

            .admin-header a {
                color: #ddd;
                text-decoration: none;
                margin-right: 20px;
            }

                .admin-header a:hover {
                    color: #fff;
                }

            .admin-header .brand {
                font-size: 20px;
                font-weight: bold;
                color: #fff;
            }

        .admin-body {
            background: #fff;
            padding: 20px;
            border-radius: 5px;
            min-height: 500px;
        }

        .admin-footer {
            text-align: left;
            padding: 20px;
            color: #666;
            font-size: 13px;
        }
    </style>
</head>
<body>
    <div class="admin-header">
        <a href="@Url.Action("Index", "Home", new { area = "Admin" })" class="brand">My Store</a>
        <a href="@Url.Action("Index", "Categories", new { area = "Admin" })">Danh mục</a>
        <a href="@Url.Action("Index", "Products", new { area = "Admin" })">Sản phẩm</a>
        <a href="@Url.Action("Index", "Customers", new { area = "Admin" })">Khách hàng</a>
        <a href="@Url.Action("Index", "Orders", new { area = "Admin" })">Đơn hàng</a>
        <a href="@Url.Action("Index", "AdminUsers", new { area = "Admin" })">Tài khoản</a>
    </div>

    <div class="container-fluid">
        <div class="admin-body">
            @RenderBody()
        </div>
    </div>

    <div class="admin-footer">
        <div>&copy; 2024 - 25dh110089_MyStore</div>
        <div><strong>Contact</strong></div>
        <div>Nhóm của bạn</div>
    </div>
</body>
</html>