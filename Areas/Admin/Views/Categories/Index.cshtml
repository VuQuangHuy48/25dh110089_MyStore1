@model IEnumerable<_25dh110089_MyStore.Models.Category>
@{ ViewBag.Title = "Danh sách danh mục"; }

<h2>Danh sách danh mục</h2>
<p>@Html.ActionLink("Thêm danh mục mới", "Create", null, new { @class = "btn btn-primary" })</p>

<table class="table table-bordered table-striped">
    <tr>
        <th>Mã DM</th>
        <th>Tên danh mục</th>
        <th>Thao tác</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.CategoryID</td>
            <td>@item.CategoryName</td>
            <td>
                @Html.ActionLink("Chi tiết", "Details", new { id = item.CategoryID }) |
                @Html.ActionLink("Sửa", "Edit", new { id = item.CategoryID }) |
                @Html.ActionLink("Xóa", "Delete", new { id = item.CategoryID })
            </td>
        </tr>
    }
</table>