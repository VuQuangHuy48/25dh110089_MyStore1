@model _25dh110089_MyStore.Models.Category
@{ ViewBag.Title = "Chi tiết danh mục"; }

<h2>Chi tiết danh mục</h2>
<dl class="dl-horizontal">
    <dt>Mã danh mục</dt>
    <dd>@Html.DisplayFor(m => m.CategoryID)</dd>
    <dt>Tên danh mục</dt>
    <dd>@Html.DisplayFor(m => m.CategoryName)</dd>
</dl>
<p>
    @Html.ActionLink("Sửa", "Edit", new { id = Model.CategoryID }) |
    @Html.ActionLink("Quay lại danh sách", "Index")
</p>