@model _25dh110089_MyStore.Models.Category
@{ ViewBag.Title = "Xóa danh mục"; }

<h2>Xóa danh mục</h2>
<h4 class="text-danger">Bạn có chắc chắn muốn xóa danh mục này?</h4>
<dl class="dl-horizontal">
    <dt>Mã danh mục</dt>
    <dd>@Html.DisplayFor(m => m.CategoryID)</dd>
    <dt>Tên danh mục</dt>
    <dd>@Html.DisplayFor(m => m.CategoryName)</dd>
</dl>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div class="form-actions">
        <input type="submit" value="Xóa" class="btn btn-danger" />
        @Html.ActionLink("Hủy", "Index", null, new { @class = "btn btn-default" })
    </div>
}