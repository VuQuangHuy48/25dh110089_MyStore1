@model IEnumerable<_25dh110089_MyStore.Models.User>
@{ ViewBag.Title = "Quản lý tài khoản Admin"; }

<h2>Danh sách tài khoản Admin</h2>

<form method="get" class="form-inline mb-3">
    <input type="text" name="keyword" value="@ViewBag.Keyword" placeholder="Tìm username..." class="form-control mr-2" />
    <button type="submit" class="btn btn-primary">Tìm kiếm</button>
    @Html.ActionLink("+ Thêm tài khoản", "Create", null, new { @class = "btn btn-success float-right" })
</form>

<table class="table table-bordered">
    <tr class="bg-light"><th>Tài khoản</th><th>Mật khẩu</th><th>Quyền</th><th>Thao tác</th></tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Username</td>
            <td>@item.Password</td>
            <td>@item.UserRole</td>
            <td>
                @Html.ActionLink("Sửa", "Edit", new { id = item.Username }) |
                @Html.ActionLink("Xóa", "Delete", new { id = item.Username })
            </td>
        </tr>
    }
</table>

<nav>
    <ul class="pagination">
        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <li class="page-item @(i == ViewBag.Page ? "active" : "")">
                @Html.ActionLink(i.ToString(), "Index", new { keyword = ViewBag.Keyword, page = i }, new { @class = "page-link" })
            </li>
        }
    </ul>
</nav>