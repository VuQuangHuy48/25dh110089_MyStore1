@model _25dh110089_MyStore.Models.Product
@{ ViewBag.Title = "Xóa sản phẩm"; }
<h2>Xóa sản phẩm</h2>
<h4 class="text-danger">Bạn có chắc chắn muốn xóa sản phẩm này?</h4>
<dl class="dl-horizontal">
    <dt>Tên sản phẩm</dt>
    <dd>@Model.ProductName</dd>
    <dt>Giá bán</dt>
    <dd>@String.Format("{0:N0} đ", Model.ProductPrice)</dd>
</dl>
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <input type="submit" value="Xóa" class="btn btn-danger" />
    @Html.ActionLink("Hủy", "Index", null, new { @class = "btn btn-default" })
}