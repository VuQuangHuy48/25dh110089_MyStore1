@model IEnumerable<_25dh110089_MyStore.Models.Product>
@{ ViewBag.Title = "Quản lý sản phẩm"; }

<h2>Danh sách sản phẩm</h2>

@using (Html.BeginForm("Index", "Products", FormMethod.Get, new { @class = "form-inline mb-3" }))
{
    <input type="text" name="keyword" value="@ViewBag.Keyword" placeholder="Tìm theo tên hoặc mô tả..." class="form-control mr-2" style="width:250px" />
    <select name="sort" class="form-control mr-2">
        <option value="">Sắp xếp mặc định</option>
        <option value="name_asc" @(ViewBag.Sort == "name_asc" ? "selected" : "")>Tên A→Z</option>
        <option value="name_desc" @(ViewBag.Sort == "name_desc" ? "selected" : "")>Tên Z→A</option>
        <option value="price_asc" @(ViewBag.Sort == "price_asc" ? "selected" : "")>Giá tăng dần</option>
        <option value="price_desc" @(ViewBag.Sort == "price_desc" ? "selected" : "")>Giá giảm dần</option>
    </select>
    <button type="submit" class="btn btn-primary">Tìm kiếm</button>
    @Html.ActionLink("+ Thêm sản phẩm", "Create", null, new { @class = "btn btn-success float-right" })
}

<p class="text-muted mt-2">Tổng cộng: <b>@ViewBag.TotalItems</b> sản phẩm.</p>

<table class="table table-bordered table-striped table-hover">
    <tr class="bg-light">
        <th>Ảnh</th>
        <th>Tên sản phẩm</th>
        <th>Danh mục</th>
        <th>Giá bán</th>
        <th>Thao tác</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>
                <img src="~/Content/Images/@item.ProductImage" width="80" onerror="this.src='https://via.placeholder.com/80?text=No+Image'" />
            </td>
            <td>@item.ProductName</td>
            <td>@(item.Category != null ? item.Category.CategoryName : "")</td>
            <td>@String.Format("{0:N0} đ", item.ProductPrice)</td>
            <td>
                @Html.ActionLink("Chi tiết", "Details", new { id = item.ProductID }) |
                @Html.ActionLink("Sửa", "Edit", new { id = item.ProductID }) |
                @Html.ActionLink("Xóa", "Delete", new { id = item.ProductID })
            </td>
        </tr>
    }
</table>

<nav>
    <ul class="pagination">
        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <li class="page-item @(i == ViewBag.Page ? "active" : "")">
                @Html.ActionLink(i.ToString(), "Index", new { keyword = ViewBag.Keyword, sort = ViewBag.Sort, page = i }, new { @class = "page-link" })
            </li>
        }
    </ul>
</nav>